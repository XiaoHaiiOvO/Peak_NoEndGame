<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Peak_NoEndGame</AssemblyName>
    <RootNamespace>Peak_NoEndGame</RootNamespace>
    <Version>2.0.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <PeakGameDir Condition="'$(PeakGameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\PEAK</PeakGameDir>
    <PeakManagedDir Condition="'$(PeakManagedDir)' == ''">$(PeakGameDir)\PEAK_Data\Managed</PeakManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(PeakGameDir)\BepInEx\core</BepInExCoreDir>
    <GameAssemblyPath Condition="'$(GameAssemblyPath)' == ''">$(PeakManagedDir)\Assembly-CSharp.dll</GameAssemblyPath>
    <ZorroCorePath Condition="'$(ZorroCorePath)' == ''">$(PeakManagedDir)\Zorro.Core.Runtime.dll</ZorroCorePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameAssemblyPath)" Private="false" />
    <Reference Include="PhotonRealtime" HintPath="$(PeakManagedDir)\PhotonRealtime.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(PeakManagedDir)\PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="Zorro.Core.Runtime" HintPath="$(ZorroCorePath)" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(PeakManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(PeakManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(PeakManagedDir)\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(PeakManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(PeakManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(PeakManagedDir)\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameAssemblyPath)')" Text="Assembly-CSharp.dll was not found. Set PeakGameDir or GameAssemblyPath to the current PEAK installation." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="BepInEx.dll was not found. Install BepInEx for PEAK or set BepInExCoreDir." />
    <Error Condition="!Exists('$(BepInExCoreDir)\0Harmony.dll')" Text="0Harmony.dll was not found. Install BepInEx for PEAK or set BepInExCoreDir." />
    <Error Condition="!Exists('$(ZorroCorePath)')" Text="Zorro.Core.Runtime.dll was not found. Set PeakManagedDir or ZorroCorePath to the current PEAK installation." />
    <Error Condition="!Exists('$(PeakManagedDir)\PhotonUnityNetworking.dll')" Text="PhotonUnityNetworking.dll was not found. Set PeakManagedDir to the current PEAK managed assembly directory." />
  </Target>
</Project>
